<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron/V8 JIT on Apple Silicon. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Local ad-hoc bundles load Electron and the prebuilt node-pty addon
         without a common Developer ID team. Not an App Sandbox entitlement. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- SynVoice explicitly requests microphone access via getUserMedia. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
